generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SwipeDirection {
  ship
  skip
  super_ship
}

enum BidStatus {
  active
  outbid
  expired
}

enum ChallengeStatus {
  pending
  verified_success
  failed_unverified
}

enum PaymentKind {
  outbid
  super_ship
  call_bs
  verify
}

enum PaymentStatus {
  pending
  completed
  failed
}

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  twitterId          String?        @unique
  username           String         @unique
  name               String?
  email              String?        @unique
  avatarUrl          String?
  stripeAccountId    String?
  stripeCustomerId   String?
  createdAt          DateTime       @default(now())
  app                App?
  swipes             Swipe[]
  watchlist          Watchlist[]
  notifications      Notification[]
  challengesMade     Challenge[]    @relation("Challenger")
  payments           Payment[]
}

model App {
  id                    String      @id @default(uuid()) @db.Uuid
  userId                String      @unique @db.Uuid
  name                  String
  tagline               String
  websiteUrl            String
  pitchVideoUrl         String?
  screenshotUrl         String?
  techStack             String[]
  mrrAmount             Decimal     @default(0) @db.Decimal(10, 2)
  isVerified            Boolean     @default(false)
  eloScore              Int         @default(1200)
  homelessUntil         DateTime?
  superShipUntil        DateTime?
  superShipImpressions  Int         @default(0)
  createdAt             DateTime    @default(now())
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  swipes                Swipe[]
  bids                  Bid[]
  challenges            Challenge[]
  watchlistedBy         Watchlist[]
}

model Swipe {
  id          String          @id @default(uuid()) @db.Uuid
  voterUserId String          @db.Uuid
  appId       String          @db.Uuid
  direction   SwipeDirection
  createdAt   DateTime        @default(now())
  voter       User            @relation(fields: [voterUserId], references: [id], onDelete: Cascade)
  app         App             @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([voterUserId, appId])
}

model Bid {
  id               String    @id @default(uuid()) @db.Uuid
  appId            String    @db.Uuid
  bidderUserId     String    @db.Uuid
  bidAmount        Decimal   @db.Decimal(10, 2)
  targetTier       String
  expiresAt        DateTime
  status           BidStatus @default(active)
  createdAt        DateTime  @default(now())
  app              App       @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([targetTier, status, expiresAt])
}

model Challenge {
  id           String          @id @default(uuid()) @db.Uuid
  challengerId String          @db.Uuid
  targetAppId  String          @db.Uuid
  stakeAmount  Decimal         @default(10.00) @db.Decimal(10, 2)
  status       ChallengeStatus @default(pending)
  expiresAt    DateTime
  createdAt    DateTime        @default(now())
  challenger   User            @relation("Challenger", fields: [challengerId], references: [id], onDelete: Cascade)
  targetApp    App             @relation(fields: [targetAppId], references: [id], onDelete: Cascade)
}

model Watchlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  appId     String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
}

model Notification {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  title         String
  body          String
  counterBidUrl String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String        @db.Uuid
  kind                  PaymentKind
  status                PaymentStatus @default(pending)
  amount                Decimal       @db.Decimal(10, 2)
  stripeSessionId       String?       @unique
  appId                 String?       @db.Uuid
  targetTier            String?
  metadata              Json?
  createdAt             DateTime      @default(now())
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}
