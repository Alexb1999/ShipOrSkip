# Local Docker Postgres: both URLs can be the same.
# On Vercel/Supabase: do NOT use db.<project>.supabase.co:5432 (IPv6-only; Vercel can't reach it).
# Use Connect → Session pooler (host aws-0-….pooler.supabase.com, port 5432) for DIRECT_URL.
# DATABASE_URL can be the same, or Transaction pooler port 6543 with ?pgbouncer=true.
DATABASE_URL="postgresql://shiporskip:shiporskip@localhost:5432/shiporskip"
DIRECT_URL="postgresql://shiporskip:shiporskip@localhost:5432/shiporskip"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional — Twitter/X OAuth. Demo login works locally without these.
AUTH_TWITTER_ID=""
AUTH_TWITTER_SECRET=""

# Optional — Stripe. Locally, checkout fulfills instantly if unset.
# Production refuses payments until STRIPE_SECRET_KEY is set.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional — protect /api/cron
CRON_SECRET="dev-cron-secret"

# Optional — TrustMRR official API. Public profile pages work without this.
TRUSTMRR_API_KEY=""

# Production defaults: demo login OFF, free checkout OFF.
# Set true only for staging.
# ALLOW_DEMO_LOGIN="true"
# ALLOW_DEMO_PAYMENTS="true"
